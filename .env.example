# Canonical Lifty Supabase (wabdd…) — same Auth issuer as backend + mobile
# https://wabddbkwugepkwrgzhpk.supabase.co
# Legacy admin-only project (dlqvos…) is retired after cutover.
VITE_SUPABASE_URL=https://wabddbkwugepkwrgzhpk.supabase.co
VITE_SUPABASE_ANON_KEY=
# Backend monorepo (dev-all / dev:backend) — LAN IP en el phone, no 127.0.0.1
# getApiBase() appends /api if missing
# Prod: https://liftybackend-production.up.railway.app
VITE_API_URL=http://127.0.0.1:3001
# Optional: bake VAPID public key (same as Railway VAPID_PUBLIC_KEY).
# If unset, admin fetches GET /api/admin/push/vapid-public-key after login.
# VITE_VAPID_PUBLIC_KEY=
